{
  "name": "social-search-server",
  "version": "1.0.0",
  "description": "社交平台搜索 MCP Server + REST API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --mode stdio",
    "start:sse": "node dist/index.js --mode sse",
    "start:rest": "node dist/index.js --mode rest",
    "start:all": "node dist/index.js --mode all",
    "dev": "ts-node src/index.ts --mode all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0",
    "swagger-jsdoc": "^6.2.8",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
